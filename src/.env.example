# Tokens
DISCORD_TOKEN=your_discord_bot_token_here

# Second bot token, for music playback. Lavalink and @discordjs/voice cannot share one bot's
# voice state, so music runs on a separate Discord application invited to the same guild
# (needs Connect + Speak). Lyra herself joins to listen (/assistant, /record, spoken acks).
# Leave unset and both run on the main bot, where they contend for the one voice state.
# DISCORD_LISTENER_TOKEN is the same secret under its old name and still works.
# DISCORD_MUSIC_TOKEN=your_music_bot_token_here

# Self-hosted speech-to-text sidecar for the voice assistant (see docker/stt).
# STT_URL=http://stt:8000

# Self-hosted text-to-speech sidecar, used when a guild sets acknowledgements to spoken
# (see docker/tts). Unreachable means spoken acks quietly fall back to text.
# TTS_URL=http://tts:8000

OWNERS=123456789012345678,987654321098765432

# Optional path to the clips a `sound` voice trigger plays. Defaults to ./data/voice_sounds,
# which is inside the data volume, so clips survive a redeploy without extra configuration.
# VOICE_SOUNDS_DIR=

# Optional path to the SQLite database. Defaults to ./data/word_triggers.db
SQLITE_PATH=

# Optional development guild ID for command registration. Defaults to '925192180480491540'
BULK_OVERWRITE_GUILD_IDS=

# Environment
NODE_ENV=development

# Lavalink Configuration (required for music system)
# See LAVALINK.md for detailed setup instructions
LAVALINK_NODE_NAME=main
LAVALINK_HOST=localhost:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
# Optional Shoukaku tuning (milliseconds for interval/timeout)
# LAVALINK_RECONNECT_TRIES=5
# LAVALINK_RECONNECT_INTERVAL=3000
# LAVALINK_REST_TIMEOUT=30000

# WebUI Dashboard (optional — required to enable the web dashboard)
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_oauth2_secret_here
OAUTH_REDIRECT_URI=http://localhost:4000/oauth/callback
API_PORT=4000
DASHBOARD_ORIGIN=*